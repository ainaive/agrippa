# Agrippa worker — pg-boss consumers + the orchestration engine.
FROM oven/bun:1.3
WORKDIR /app

# Optional: swap Debian apt to a closer mirror (e.g. mirrors.aliyun.com from a
# CN host) so the apt-get below doesn't crawl deb.debian.org. No-op when unset.
# The base image is Debian (trixie), which uses deb822 sources.
#
# Only the HOST is substituted, so a value carrying a scheme would produce
# "http://https//mirror/debian" and apt would fail to resolve the host "https".
# Accept both forms and normalize rather than making that a footgun.
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then \
        host="${APT_MIRROR#*://}"; \
        host="${host%%/*}"; \
        sed -i "s|deb.debian.org|${host}|g" /etc/apt/sources.list.d/debian.sources; \
    fi

# git for run workspaces (clone/diff); ripgrep helps agent search; bubblewrap
# backs the SDK command sandbox (without it, sandboxing silently degrades);
# curl fetches the Codex CLI below
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ripgrep ca-certificates bubblewrap curl \
  && rm -rf /var/lib/apt/lists/*

# ── Codex CLI ─────────────────────────────────────────────────────────────────
# The `codex-cli` executor shells out to a real `codex` binary (ADR-0011), so the
# worker image has to carry one — without it probeCodexCli() fails, the executor
# never registers, and templates that pin `executor: codex-cli` (swdev/
# requirement-delivery) become un-submittable.
#
# We deliberately do NOT `bun install -g @openai/codex`: that package's bin is a
# Node ESM shim (`#!/usr/bin/env node`) that resolves a platform package at
# runtime, and this image has no Node. Fetch the platform package directly and
# put its statically-linked musl binary on PATH instead — it runs fine on glibc.
#
# Pinned to the release the adapter's JSONL event shapes are written against
# (packages/executor-codex/README.md). The floor is 0.122, the first release
# with the `codex exec --ignore-user-config` / `--ignore-rules` flags that
# probeCodexCli() requires; bump both together.
ARG CODEX_VERSION=0.145.0
# Closer npm registry for hosts where registry.npmjs.org is slow/blocked, the
# npm-side twin of APT_MIRROR above (e.g. https://registry.npmmirror.com).
ARG NPM_REGISTRY=https://registry.npmjs.org
# Download and unpack in one layer so the ~90 MB tarball never lands in the
# image. npm tarballs nest their payload under package/, hence
# --strip-components=1; the chmod keeps the tree readable for the non-root
# `bun` user. The vendor tree is self-contained but position-sensitive — the
# binary sits next to codex-code-mode-host/codex-path/codex-resources and finds
# them relative to its own realpath, so link to it rather than copying it out.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      amd64) plat=linux-x64 ;; \
      arm64) plat=linux-arm64 ;; \
      *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 \
      -o /tmp/codex.tgz \
      "${NPM_REGISTRY}/@openai/codex/-/codex-${CODEX_VERSION}-${plat}.tgz"; \
    mkdir -p /opt/codex; \
    tar -xzf /tmp/codex.tgz -C /opt/codex --strip-components=1; \
    rm /tmp/codex.tgz; \
    chmod -R a+rX /opt/codex; \
    bin="$(find /opt/codex/vendor -type f -name codex | head -n1)"; \
    [ -n "$bin" ] || { echo "no codex binary in the vendor tree" >&2; exit 1; }; \
    ln -s "$bin" /usr/local/bin/codex

# Fail the BUILD on a missing or too-old CLI. These are exactly the checks
# probeCodexCli() (packages/executor-codex/src/cli.ts) runs at worker boot, where
# failing them means the executor silently does not register — a broken image is
# much easier to notice here than a run rejected days later.
RUN codex --version \
  && codex exec --help | grep -q -- --ignore-user-config \
  && codex exec --help | grep -q -- --ignore-rules

COPY package.json bun.lock bunfig.toml tsconfig.base.json tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY templates ./templates
RUN bun install --frozen-lockfile

ENV NODE_ENV=production
ENV AGRIPPA_TEMPLATES_DIR=/app/templates
ENV WORKSPACE_ROOT=/work/runs
ENV ARTIFACT_STORAGE_ROOT=/work/artifacts

# Run agent code as a non-root user so a shell tool call cannot reach the
# container filesystem or other roots (docs/design/03 §Sandboxing). Only /work
# (runtime storage) is made writable — /app stays root-owned so agent commands
# can't modify worker code, dependencies, or templates and persist into later
# runs. Chowning /work here makes a freshly-created named volume inherit `bun`
# ownership.
RUN mkdir -p /work/runs /work/artifacts && chown -R bun:bun /work
USER bun
CMD ["bun", "apps/worker/src/index.ts"]
