# Agrippa self-hosted configuration (docs/design/08-deployment.md)
# Copy to infra/env/.env and fill in the secrets.

# ── Required secrets ───────────────────────────────────────────────────────────
# Encrypts stored credentials (git tokens, MCP auth). 32 bytes base64.
# LOSING THIS KEY ORPHANS ALL STORED CREDENTIALS — back it up.
#   openssl rand -base64 32
AGRIPPA_SECRET_KEY=

# Session signing secret for better-auth.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── First admin (one-time bootstrap) ───────────────────────────────────────────
# Self-registration is closed (invite-only), so create the first org_admin once,
# out of band. The credentials are NOT configured here: this file carries no
# DATABASE_URL (compose synthesizes it from POSTGRES_PASSWORD below), and its
# values reach containers only where a service lists them, so running the script
# against this file would fail on a missing database URL. Pass them to the
# container instead — full runbook in docs/manual/en/06-operations.md:
#
#   read -r -s -p 'admin password: ' PW; echo
#   docker compose -f infra/docker-compose.yml --env-file infra/env/.env exec \
#     -e AGRIPPA_BOOTSTRAP_EMAIL=you@example.com \
#     -e AGRIPPA_BOOTSTRAP_PASSWORD="$PW" \
#     api bun apps/api/src/cli/bootstrap-admin.ts
#   unset PW
#
# Idempotent on email; the account then signs in at the normal login page.

# ── Model providers ────────────────────────────────────────────────────────────
# Required for real runs (executor: claude-agent-sdk). Leave empty and set
# AGRIPPA_EXECUTOR=fake for a token-free demo deployment.
ANTHROPIC_API_KEY=
AGRIPPA_EXECUTOR=claude-agent-sdk

# Deployment-wide fallback auth for the codex-cli executor, which speaks the
# `openai` wire protocol (the reviewer slot in swdev/requirement-delivery).
# Both are forwarded to the CLI when set; setting either one is enough.
#
# Both may stay empty. Providers whose catalog entry is auth: "project" — and
# any org-registered custom provider — are authenticated by a per-project
# credential entered in the UI and encrypted under AGRIPPA_SECRET_KEY, not from
# here (ADR-0013). Such a credential always wins: the worker drops the entire
# OPENAI_API_KEY/OPENAI_BASE_URL/CODEX_API_KEY/CODEX_HOME family before applying
# it, so a value here can never outrank a project's. A keyless worker still
# registers codex-cli; the engine simply defers runs that would need env auth it
# doesn't have.
#
# Note: dashscope (Aliyun Bailian) cannot back a codex-cli slot — its catalog
# entry serves the `anthropic` protocol only, because Codex >= 0.122 dropped the
# chat wire API that Bailian's OpenAI-compatible mode speaks.
OPENAI_API_KEY=
CODEX_API_KEY=

# ── Codex CLI image build ──────────────────────────────────────────────────────
# Version of the Codex CLI baked into the worker image, pinned to the release
# the adapter's event shapes are written against (packages/executor-codex/
# README.md). The floor is 0.122, the first release with `codex exec
# --ignore-user-config` / `--ignore-rules`; the image build fails loudly if the
# binary is older.
CODEX_VERSION=0.145.0
# Where to fetch it from. Use https://registry.npmmirror.com from CN hosts, the
# npm-side twin of APT_MIRROR below.
NPM_REGISTRY=https://registry.npmjs.org

# ── Deployment ─────────────────────────────────────────────────────────────────
# Public URL of the instance (links in PRs/emails, auth callbacks).
AGRIPPA_BASE_URL=http://localhost:3000
# Published API port. This is the LEFT side of the compose port mapping, so it
# can carry an interface: behind a reverse proxy use
#   AGRIPPA_PORT=127.0.0.1:3000
# otherwise the plain-HTTP API binds 0.0.0.0 and is reachable from the internet
# alongside your TLS terminator.
AGRIPPA_PORT=3000
POSTGRES_PASSWORD=change-me
WORKER_SLOTS=2
WORKER_REPLICAS=1
# Image tag when pulling instead of building.
AGRIPPA_VERSION=latest

# Optional: closer Debian apt mirror for the worker image build, for hosts where
# deb.debian.org is slow/blocked (e.g. CN). Leave empty elsewhere. This is a
# HOST, not a URL — a scheme is stripped if you include one.
#   APT_MIRROR=mirrors.aliyun.com
APT_MIRROR=

# ── Optional toggles ───────────────────────────────────────────────────────────
# Per-artifact size cap in bytes (default 25 MiB). Values that aren't a positive
# integer fall back to the default rather than lifting the cap.
# AGRIPPA_MAX_ARTIFACT_BYTES=26214400
#
# AGRIPPA_SCM=fake fabricates branch/push/PR instead of touching a real remote —
# for demoing the delivery workflow without a repository connection.
# AGRIPPA_SCM=fake
#
# AGRIPPA_MIGRATE_ON_BOOT=0 disables the automatic migrate + seed the API runs
# at startup. Only the exact string "0" disables it.
# AGRIPPA_MIGRATE_ON_BOOT=0
#
# AGRIPPA_KEEP_WORKSPACES=1 keeps finished run checkouts on disk for debugging.
# AGRIPPA_KEEP_WORKSPACES=1
#
# How often the run-event stream emits a keepalive comment frame, in ms
# (default 15000). Lower it only for an intermediary that reaps idle
# connections faster than that.
# AGRIPPA_SSE_KEEPALIVE_MS=15000
